{
  "manifest_version": 3,
  "name": "SCINTILLA Station X Bridge",
  "version": "0.7.3",
  "description": "Feeds a dedicated X tab into the SCINTILLA Station X pane. Separate from X Feed Float.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "offscreen",
    "scripting",
    "storage",
    "tabCapture",
    "windows"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://scintilla-widgets.vercel.app/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Connect this X tab to SCINTILLA Station",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://scintilla-widgets.vercel.app/pane-x*",
        "http://127.0.0.1/pane-x*",
        "http://localhost/pane-x*"
      ],
      "js": [
        "station-bridge.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Connect this X tab to SCINTILLA Station"
    }
  }
}
