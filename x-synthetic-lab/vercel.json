{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "X-SCINTILLA-Surface", "value": "x-synthetic-lab" },
        { "key": "Content-Security-Policy", "value": "default-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'unsafe-inline'; img-src 'none'; connect-src 'none'; media-src 'none'; frame-src 'none'; font-src 'none'; base-uri 'none'; form-action 'none'" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), display-capture=(), geolocation=()" }
      ]
    }
  ]
}
